<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0C"
    android:padding="8dp">

    <!-- Top Header & Streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="♟️ GAMBIT"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHubStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 1d"
            android:textColor="#F97316"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#1C1917"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Side Picker Tabs: [⚪ WHITE] vs [⚫ BLACK] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="#121216"
        android:padding="2dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnTabWhite"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="⚪ PLAY AS WHITE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#2563EB" />

        <Button
            android:id="@+id/btnTabBlack"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="⚫ PLAY AS BLACK"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:background="#18181E"
            android:layout_marginLeft="2dp" />
    </LinearLayout>

    <!-- Filtered Courses List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llCoursesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
