<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C">

    <!-- Top Action / Status Bar (HIDES during training, SHOWS on completion) -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#121216"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBackToLibrary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="☷ LIBRARY"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#2563EB"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="The Italian Game"
            android:textColor="#F3F4F6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvTopStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 1d"
            android:textColor="#F97316"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#1C1917"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Main Content Area: Centered Board + Bottom Floating Coach Pill -->
    <LinearLayout
        android:id="@+id/llBoardArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llTopBar"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Maximized Chess Board View -->
        <FrameLayout
            android:id="@+id/flBoardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <com.gambit.app.ChessBoardView
                android:id="@+id/chessBoardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Option C: Compact Floating Coach Pill (Height ~44dp, leaves board huge) -->
        <LinearLayout
            android:id="@+id/llCoachPill"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#16161B"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@+id/tvCoachBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. e4"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#1E293B"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvCoachPrompt"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Claim the Center"
                android:textColor="#E5E7EB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnWhyExplain"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="💡 WHY?"
                android:textColor="#FBBF24"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#27272A"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />

            <Button
                android:id="@+id/btnModeQuick"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="[STUDY]"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:background="#27272A"
                android:layout_marginLeft="6dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp" />
        </LinearLayout>

        <!-- Chapter Completion Card (Shows only when chapter is done) -->
        <LinearLayout
            android:id="@+id/llCompletionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#18181F"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCompletionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ CHAPTER COMPLETE!"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompletionStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mastery Level: ★★★★★ • Accuracy: 100%"
                android:textColor="#D1D5DB"
                android:textSize="12sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDrillAgain"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:text="↺ RETRAIN"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:background="#27272A" />

                <Button
                    android:id="@+id/btnNextLine"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:text="NEXT CHAPTER ❯"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#2563EB"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Why/Explanation Dialog Card (Modal overlay) -->
    <FrameLayout
        android:id="@+id/flExplainOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:gravity="center"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:orientation="vertical"
            android:background="#1E1E24"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvOverlayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. e4"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="#0F172A"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Claim the Center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="8dp" />

                <TextView
                    android:id="@+id/btnCloseOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#9CA3AF"
                    android:textSize="18sp"
                    android:padding="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOverlayBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We stake an immediate claim on the critical d5 square, free our Light-squared Bishop, and open the diagonal for our Queen."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/tvOverlayWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Never start with passive pawn moves like a3 or h3 — always claim the center first!"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:background="#2E1317"
                android:padding="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGotIt"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="GOT IT, LET'S PLAY ❯"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#2563EB"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
