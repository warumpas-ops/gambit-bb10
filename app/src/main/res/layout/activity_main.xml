<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0C"
    android:padding="8dp">

    <!-- Top Action / Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvOpeningTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="The Italian Game"
            android:textColor="#F3F4F6"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="[STUDY]"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#18181B"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <Button
            android:id="@+id/btnNextChapter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="▶ CHAPTERS"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:background="#18181B"
            android:layout_marginLeft="6dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

    <!-- Subtitle / Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvChapterSubtitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Chapter 1: Fried Liver Attack"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvStepProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1/9"
            android:textColor="#6B7280"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The 8x8 Chessboard Canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <com.gambit.app.ChessBoardView
            android:id="@+id/chessBoardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Instructional Bottom Card (The Human "Why") -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121215"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Move badge + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvMoveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. e4"
                    android:textColor="#10B981"
                    android:background="#1E293B"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tvStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Claim the Center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="8dp" />
            </LinearLayout>

            <!-- Explanation Body -->
            <TextView
                android:id="@+id/tvExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We stake an immediate claim on the critical d5 square, free our Light-squared Bishop, and open the diagonal for our Queen."
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

            <!-- Warning Callout Box (Optional) -->
            <TextView
                android:id="@+id/tvWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Never start with passive pawn moves like a3 or h3 — always claim the center first!"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:background="#271518"
                android:padding="6dp"
                android:visibility="gone"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <!-- Status Banner (for Drill Mode feedback) -->
            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ EXCELLENT MOVE!"
                android:textColor="#34D399"
                android:textStyle="bold"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:visibility="gone" />

            <!-- Control Buttons (Reset / Hint / Next) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:text="↺ RESET"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:background="#1F2937" />

                <Button
                    android:id="@+id/btnHint"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:text="💡 HINT"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:background="#1F2937"
                    android:layout_marginLeft="6dp" />

                <Button
                    android:id="@+id/btnNextStep"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:text="NEXT ❯"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#2563EB"
                    android:layout_marginLeft="6dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
